# Template for the local E2E test environment — copy to .env.test and adjust if needed.
# Never point this at the dev or production database (Testing & QA Spec section 7).
# Requires `docker compose up postgres-test` from web/ (see docker-compose.yml).

TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/quote_invoice_builder_test"

# The E2E-run Next.js server needs the same variables the app normally needs,
# pointed at the test database instead of dev:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/quote_invoice_builder_test"
AUTH_SECRET="e2e-test-secret-not-for-real-use"

# playwright.config.ts runs the app via `next build && next start`, which enforces
# Auth.js's production Host-header check (dev mode implicitly trusts localhost, a
# production build does not) — without this, every /api/auth/* request 500s with
# "UntrustedHost". Must match E2E_BASE_URL below.
AUTH_URL="http://localhost:3100"
AUTH_TRUST_HOST="true"

E2E_BASE_URL="http://localhost:3100"
